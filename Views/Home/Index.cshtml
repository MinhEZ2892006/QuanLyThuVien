@model QuanLyThuVIen.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Trang chủ";
}

<h1><i class="bi bi-grid-1x2-fill"></i> Tổng quan hệ thống quản lý thư viện</h1>

<div class="row g-3 mt-2">
    <div class="col-sm-6 col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <div class="stat-icon"><i class="bi bi-upc-scan"></i></div>
                <h2>@Model.TotalBooks</h2>
                <p class="text-muted mb-0"><i class="bi bi-tag-fill"></i> Mã sách</p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <div class="stat-icon"><i class="bi bi-books"></i></div>
                <h2>@Model.TotalBookCopies</h2>
                <p class="text-muted mb-0"><i class="bi bi-collection-fill"></i> Đầu sách</p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <div class="stat-icon"><i class="bi bi-arrow-left-right"></i></div>
                <h2>@Model.BorrowedCopies</h2>
                <p class="text-muted mb-0"><i class="bi bi-box-arrow-right"></i> Đầu sách đang cho mượn</p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card text-center border-danger">
            <div class="card-body">
                <div class="stat-icon"><i class="bi bi-exclamation-octagon-fill"></i></div>
                <h2 class="text-danger">@Model.LostOrDamagedCopies</h2>
                <p class="text-muted mb-0"><i class="bi bi-x-octagon-fill"></i> Đầu sách mất/hỏng</p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <div class="stat-icon"><i class="bi bi-person-vcard-fill"></i></div>
                <h2>@Model.TotalCards</h2>
                <p class="text-muted mb-0"><i class="bi bi-credit-card-2-front-fill"></i> Thẻ thư viện</p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card text-center border-warning">
            <div class="card-body">
                <div class="stat-icon"><i class="bi bi-shield-lock-fill"></i></div>
                <h2 class="text-warning">@Model.LockedCards</h2>
                <p class="text-muted mb-0"><i class="bi bi-lock-fill"></i> Thẻ đang bị khóa</p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card text-center">
            <div class="card-body">
                <div class="stat-icon"><i class="bi bi-journal-check"></i></div>
                <h2>@Model.ActiveLoans</h2>
                <p class="text-muted mb-0"><i class="bi bi-hourglass-split"></i> Phiếu mượn đang hoạt động</p>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-md-3">
        <div class="card text-center border-danger">
            <div class="card-body">
                <div class="stat-icon"><i class="bi bi-cash-coin"></i></div>
                <h2 class="text-danger">@Model.UnresolvedCompensationCases</h2>
                <p class="text-muted mb-0"><i class="bi bi-exclamation-triangle-fill"></i> Case bồi thường chưa xử lý</p>
            </div>
        </div>
    </div>
</div>

<div class="mt-4 d-flex flex-wrap gap-2">
    <a asp-controller="Book" asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-book-half"></i> Quản lý sách</a>
    <a asp-controller="LibraryCard" asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-person-vcard-fill"></i> Quản lý thẻ thư viện</a>
    <a asp-controller="Loan" asp-action="Create" class="btn btn-outline-primary"><i class="bi bi-arrow-left-right"></i> Lập phiếu mượn</a>
    <a asp-controller="Report" asp-action="Index" class="btn btn-outline-primary"><i class="bi bi-bar-chart-line-fill"></i> Báo cáo mất/hỏng</a>
</div>

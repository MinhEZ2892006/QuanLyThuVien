@model QuanLyThuVIen.Models.BookCopy

@{
    ViewData["Title"] = "Thêm đầu sách mới";
}

<h1><i class="bi bi-plus-circle-fill"></i> Thêm đầu sách mới</h1>
<p><i class="bi bi-upc"></i> Mã sách: <strong>@Model.BookCode</strong> - @ViewBag.BookTitle</p>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="BookCode" />

            <div class="form-group mb-3">
                <label asp-for="ControlNumber" class="control-label"><i class="bi bi-hash"></i> Số kiểm soát</label>
                <input asp-for="ControlNumber" class="form-control" />
                <span asp-validation-for="ControlNumber" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Note" class="control-label"><i class="bi bi-chat-left-text-fill"></i> Ghi chú</label>
                <input asp-for="Note" class="form-control" />
                <span asp-validation-for="Note" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary"><i class="bi bi-save-fill"></i> Lưu</button>
            <a asp-controller="Book" asp-action="Details" asp-route-id="@Model.BookCode" class="btn btn-secondary"><i class="bi bi-x-circle"></i> Hủy</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@model QuanLyThuVIen.Models.BookCopy

@{
    ViewData["Title"] = "Đổi tình trạng đầu sách";
}

<h1><i class="bi bi-arrow-repeat"></i> Đổi tình trạng đầu sách</h1>

<div>
    <dl class="row">
        <dt class="col-sm-3"><i class="bi bi-upc"></i> Mã sách</dt>
        <dd class="col-sm-9">@Model.BookCode</dd>

        <dt class="col-sm-3"><i class="bi bi-hash"></i> Số kiểm soát</dt>
        <dd class="col-sm-9">@Model.ControlNumber</dd>

        <dt class="col-sm-3"><i class="bi bi-activity"></i> Tình trạng hiện tại</dt>
        <dd class="col-sm-9">
            @switch (Model.Status)
            {
                case QuanLyThuVIen.Models.BookCopyStatus.Available:
                    <span class="badge bg-success"><i class="bi bi-check-circle-fill"></i> Còn</span>
                    break;
                case QuanLyThuVIen.Models.BookCopyStatus.Borrowed:
                    <span class="badge bg-primary"><i class="bi bi-arrow-left-right"></i> Cho mượn</span>
                    break;
                case QuanLyThuVIen.Models.BookCopyStatus.Lost:
                    <span class="badge bg-dark"><i class="bi bi-x-octagon-fill"></i> Mất</span>
                    break;
                case QuanLyThuVIen.Models.BookCopyStatus.Damaged:
                    <span class="badge bg-danger"><i class="bi bi-exclamation-triangle-fill"></i> Hỏng</span>
                    break;
            }
        </dd>
    </dl>
</div>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

@if (Model.Status != QuanLyThuVIen.Models.BookCopyStatus.Borrowed)
{
    <form asp-action="ChangeStatus" asp-route-id="@Model.BookCopyId" method="post">
        <div class="form-group mb-3">
            <label class="control-label"><i class="bi bi-list-check"></i> Đổi sang tình trạng</label>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="newStatus" id="statusLost"
                       value="@QuanLyThuVIen.Models.BookCopyStatus.Lost" checked>
                <label class="form-check-label" for="statusLost"><i class="bi bi-x-octagon-fill"></i> Mất</label>
            </div>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="newStatus" id="statusDamaged"
                       value="@QuanLyThuVIen.Models.BookCopyStatus.Damaged">
                <label class="form-check-label" for="statusDamaged"><i class="bi bi-exclamation-triangle-fill"></i> Hỏng</label>
            </div>
        </div>

        <button type="submit" class="btn btn-primary"><i class="bi bi-save-fill"></i> Lưu</button>
        <a asp-controller="Book" asp-action="Details" asp-route-id="@Model.BookCode" class="btn btn-secondary"><i class="bi bi-x-circle"></i> Hủy</a>
    </form>
}
else
{
    <p class="text-warning"><i class="bi bi-exclamation-triangle-fill"></i> Đầu sách đang cho mượn — phải xử lý qua chức năng Báo mất/Báo hỏng khi trả sách (giai đoạn 5).</p>
    <a asp-controller="Book" asp-action="Details" asp-route-id="@Model.BookCode" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại</a>
}

@model List<QuanLyThuVIen.Models.CompensationCase>
@using QuanLyThuVIen.Models

@{
    ViewData["Title"] = "Báo cáo sách mất/hỏng theo năm";
    var years = (List<int>)ViewBag.Years;
    var selectedYear = (int?)ViewBag.SelectedYear;
}

<h1><i class="bi bi-bar-chart-line-fill"></i> Báo cáo sách mất/hỏng theo năm</h1>

<form method="get" class="row g-2 mb-3 align-items-end">
    <div class="col-auto">
        <label class="form-label"><i class="bi bi-calendar-event-fill"></i> Năm</label>
        <select name="year" class="form-select">
            <option value="">-- Tất cả --</option>
            @foreach (var y in years)
            {
                <option value="@y" selected="@(selectedYear == y)">@y</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <label class="form-label"><i class="bi bi-search"></i> Tìm kiếm</label>
        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control"
               placeholder="Số thẻ, họ tên, mã/tên sách..." style="min-width: 280px;" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-primary"><i class="bi bi-search"></i> Lọc</button>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x-circle"></i> Xóa lọc</a>
    </div>
</form>

@if (!Model.Any())
{
    <p class="text-muted"><i class="bi bi-inboxes"></i> Không có sách mất/hỏng nào @(selectedYear.HasValue ? $"trong năm {selectedYear}" : "").</p>
}
else
{
    <p>
        <i class="bi bi-collection-fill"></i> Tổng số: <strong>@Model.Count</strong> -
        <i class="bi bi-x-octagon-fill"></i> Mất: <strong>@Model.Count(c => c.Reason == CompensationReason.Lost)</strong> -
        <i class="bi bi-exclamation-triangle-fill"></i> Hỏng: <strong>@Model.Count(c => c.Reason == CompensationReason.Damaged)</strong> -
        <i class="bi bi-hourglass-split"></i> Chưa bồi thường: <strong>@Model.Count(c => !c.IsResolved)</strong>
    </p>

    <table class="table table-sm">
        <thead>
            <tr>
                <th><i class="bi bi-calendar-event-fill"></i> Ngày phát sinh</th>
                <th><i class="bi bi-upc"></i> Mã sách</th>
                <th><i class="bi bi-bookmark-fill"></i> Tên sách</th>
                <th><i class="bi bi-hash"></i> Số kiểm soát</th>
                <th><i class="bi bi-list-check"></i> Lý do</th>
                <th><i class="bi bi-person-vcard-fill"></i> Số thẻ</th>
                <th><i class="bi bi-cash-coin"></i> Bồi thường</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.CreatedDate.ToString("dd/MM/yyyy")</td>
                    <td>@c.LoanDetail?.BookCopy?.BookCode</td>
                    <td>@c.LoanDetail?.BookCopy?.Book?.Title</td>
                    <td>@c.LoanDetail?.BookCopy?.ControlNumber</td>
                    <td>
                        @if (c.Reason == CompensationReason.Lost)
                        {
                            <span class="badge bg-danger"><i class="bi bi-x-octagon-fill"></i> Mất</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle-fill"></i> Hỏng</span>
                        }
                    </td>
                    <td>
                        <a asp-controller="LibraryCard" asp-action="Details" asp-route-id="@c.CardNumber">@c.CardNumber</a>
                    </td>
                    <td>
                        @if (c.IsResolved)
                        {
                            <span class="badge bg-success"><i class="bi bi-check-circle-fill"></i> Đã bồi thường</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary"><i class="bi bi-hourglass-split"></i> Chưa bồi thường</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@model QuanLyThuVIen.Models.LibraryCard

@{
    ViewData["Title"] = "Chi tiết thẻ thư viện";
}

<h1><i class="bi bi-info-circle-fill"></i> Chi tiết thẻ thư viện</h1>

<div>
    <dl class="row">
        <dt class="col-sm-2"><i class="bi bi-credit-card-2-front-fill"></i> Số thẻ</dt>
        <dd class="col-sm-10">@Model.CardNumber</dd>

        <dt class="col-sm-2"><i class="bi bi-person-fill"></i> Họ tên sinh viên</dt>
        <dd class="col-sm-10">@Model.StudentName</dd>

        <dt class="col-sm-2"><i class="bi bi-calendar-x-fill"></i> Ngày hết hạn</dt>
        <dd class="col-sm-10">@Model.ExpiryDate.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-2"><i class="bi bi-activity"></i> Tình trạng</dt>
        <dd class="col-sm-10">
            @if (Model.Status == QuanLyThuVIen.Models.LibraryCardStatus.Active)
            {
                <span class="badge bg-success"><i class="bi bi-unlock-fill"></i> Sử dụng được</span>
            }
            else
            {
                <span class="badge bg-danger"><i class="bi bi-lock-fill"></i> Không sử dụng</span>
            }
        </dd>
    </dl>
</div>

@* Danh sách phiếu mượn đang hoạt động của thẻ này (tính runtime) - bước 4.6, xem ở LoanController.ActiveLoans *@

<div class="d-flex flex-wrap gap-2">
    <a asp-controller="Loan" asp-action="ActiveLoans" asp-route-cardNumber="@Model.CardNumber" class="btn btn-info"><i class="bi bi-journal-check"></i> Phiếu mượn đang hoạt động</a>
    <a asp-action="Edit" asp-route-id="@Model.CardNumber" class="btn btn-primary"><i class="bi bi-calendar-plus-fill"></i> Gia hạn</a>
    <a asp-action="ToggleStatus" asp-route-id="@Model.CardNumber" class="btn btn-warning"><i class="bi bi-shield-lock-fill"></i> Khóa/Mở thẻ</a>
    <a asp-controller="Compensation" asp-action="Index" asp-route-cardNumber="@Model.CardNumber" class="btn btn-danger"><i class="bi bi-cash-coin"></i> Bồi thường / Mở lại thẻ</a>
    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại danh sách</a>
</div>

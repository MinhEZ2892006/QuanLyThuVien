@model QuanLyThuVIen.Models.LibraryCard

@{
    ViewData["Title"] = "Gia hạn thẻ thư viện";
}

<h1><i class="bi bi-calendar-plus-fill"></i> Gia hạn thẻ thư viện</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" asp-route-id="@Model.CardNumber" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @* Chỉ cho gia hạn Ngày hết hạn; Số thẻ và Họ tên chỉ hiển thị, không sửa qua form này *@
            <div class="form-group mb-3">
                <label asp-for="CardNumber" class="control-label"><i class="bi bi-credit-card-2-front-fill"></i> Số thẻ</label>
                <input asp-for="CardNumber" class="form-control" disabled />
            </div>
            <input type="hidden" asp-for="CardNumber" />

            <div class="form-group mb-3">
                <label asp-for="StudentName" class="control-label"><i class="bi bi-person-fill"></i> Họ tên sinh viên</label>
                <input asp-for="StudentName" class="form-control" disabled />
            </div>
            <input type="hidden" asp-for="StudentName" />

            <div class="form-group mb-3">
                <label asp-for="ExpiryDate" class="control-label"><i class="bi bi-calendar-x-fill"></i> Ngày hết hạn</label>
                <input asp-for="ExpiryDate" class="form-control" />
                <span asp-validation-for="ExpiryDate" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary"><i class="bi bi-save-fill"></i> Lưu</button>
            <a asp-action="Details" asp-route-id="@Model.CardNumber" class="btn btn-secondary"><i class="bi bi-x-circle"></i> Hủy</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

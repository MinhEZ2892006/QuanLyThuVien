@model IEnumerable<QuanLyThuVIen.Models.LibraryCard>

@{
    ViewData["Title"] = "Danh sách thẻ thư viện";
}

<h1><i class="bi bi-person-vcard-fill"></i> Danh sách thẻ thư viện</h1>

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-end mb-3">
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle-fill"></i> Cấp thẻ mới</a>

    <form asp-action="Index" method="get" class="d-flex gap-2">
        <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control"
               placeholder="Tìm theo số thẻ hoặc họ tên sinh viên..." style="min-width: 320px;" />
        <button type="submit" class="btn btn-outline-primary text-nowrap flex-shrink-0"><i class="bi bi-search"></i> Tìm kiếm</button>
    <a asp-action="Index" class="btn btn-outline-secondary text-nowrap flex-shrink-0"><i class="bi bi-x-circle"></i> Xóa lọc</a>
    </form>
</div>

@if (!Model.Any())
{
    <p class="text-muted"><i class="bi bi-inboxes"></i> Không tìm thấy thẻ thư viện nào phù hợp.</p>
}
else
{
<table class="table table-striped table-bordered align-middle">
    <thead>
        <tr>
            <th><i class="bi bi-credit-card-2-front-fill"></i> Số thẻ</th>
            <th><i class="bi bi-person-fill"></i> Họ tên sinh viên</th>
            <th><i class="bi bi-calendar-x-fill"></i> Ngày hết hạn</th>
            <th><i class="bi bi-activity"></i> Tình trạng</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var card in Model)
        {
            <tr>
                <td>@card.CardNumber</td>
                <td>@card.StudentName</td>
                <td>@card.ExpiryDate.ToString("dd/MM/yyyy")</td>
                <td>
                    @if (card.Status == QuanLyThuVIen.Models.LibraryCardStatus.Active)
                    {
                        <span class="badge bg-success"><i class="bi bi-unlock-fill"></i> Sử dụng được</span>
                    }
                    else
                    {
                        <span class="badge bg-danger"><i class="bi bi-lock-fill"></i> Không sử dụng</span>
                    }
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@card.CardNumber" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye-fill"></i> Chi tiết</a>
                    <a asp-action="Edit" asp-route-id="@card.CardNumber" class="btn btn-sm btn-outline-primary"><i class="bi bi-calendar-plus-fill"></i> Gia hạn</a>
                    <a asp-action="ToggleStatus" asp-route-id="@card.CardNumber" class="btn btn-sm btn-outline-warning"><i class="bi bi-shield-lock-fill"></i> Khóa/Mở</a>
                </td>
            </tr>
        }
    </tbody>
</table>
}

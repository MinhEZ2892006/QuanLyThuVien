@model QuanLyThuVIen.Models.LibraryCard

@{
    ViewData["Title"] = "Khóa / Mở thẻ thư viện";
    var isActive = Model.Status == QuanLyThuVIen.Models.LibraryCardStatus.Active;
}

<h1><i class="bi bi-shield-lock-fill"></i> Khóa / Mở thẻ thư viện</h1>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div>
    <dl class="row">
        <dt class="col-sm-2"><i class="bi bi-credit-card-2-front-fill"></i> Số thẻ</dt>
        <dd class="col-sm-10">@Model.CardNumber</dd>

        <dt class="col-sm-2"><i class="bi bi-person-fill"></i> Họ tên sinh viên</dt>
        <dd class="col-sm-10">@Model.StudentName</dd>

        <dt class="col-sm-2"><i class="bi bi-activity"></i> Tình trạng hiện tại</dt>
        <dd class="col-sm-10">
            @if (isActive)
            {
                <span class="badge bg-success"><i class="bi bi-unlock-fill"></i> Sử dụng được</span>
            }
            else
            {
                <span class="badge bg-danger"><i class="bi bi-lock-fill"></i> Không sử dụng</span>
            }
        </dd>
    </dl>

    <p>
        @(isActive
            ? "Bạn có chắc muốn KHÓA thẻ này (chuyển sang Không sử dụng)?"
            : "Bạn có chắc muốn MỞ KHÓA thẻ này (chuyển sang Sử dụng được)?")
    </p>

    <form asp-action="ToggleStatus" asp-route-id="@Model.CardNumber" method="post">
        <button type="submit" class="btn @(isActive ? "btn-danger" : "btn-success")">
            <i class="bi @(isActive ? "bi-lock-fill" : "bi-unlock-fill")"></i>
            @(isActive ? "Khóa thẻ" : "Mở khóa thẻ")
        </button>
        <a asp-action="Details" asp-route-id="@Model.CardNumber" class="btn btn-secondary"><i class="bi bi-x-circle"></i> Hủy</a>
    </form>
</div>

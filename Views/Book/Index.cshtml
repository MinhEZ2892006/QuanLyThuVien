@model IEnumerable<QuanLyThuVIen.Models.Book>

@{
    ViewData["Title"] = "Danh sách sách";
    int currentPage = ViewData["CurrentPage"] is int cp ? cp : 1;
    int totalPages = ViewData["TotalPages"] is int tp ? tp : 1;
}

<h1><i class="bi bi-book-half"></i> Danh sách sách</h1>

<div class="d-flex flex-wrap gap-2 justify-content-between align-items-end mb-3">
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle-fill"></i> Thêm mã sách mới</a>

    <form asp-action="Index" method="get" class="d-flex gap-2">
    <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control"
           placeholder="Tìm theo mã sách, tên sách, tác giả, thể loại, NXB..." style="min-width: 320px;" />
    <button type="submit" class="btn btn-outline-primary text-nowrap flex-shrink-0"><i class="bi bi-search"></i> Tìm kiếm</button>
    <a asp-action="Index" class="btn btn-outline-secondary text-nowrap flex-shrink-0"><i class="bi bi-x-circle"></i> Xóa lọc</a>
</form>
</div>

@if (!Model.Any())
{
    <p class="text-muted"><i class="bi bi-inboxes"></i> Không tìm thấy mã sách nào phù hợp.</p>
}
else
{
    <table class="table table-striped table-bordered align-middle">
        <thead>
            <tr>
                <th><i class="bi bi-image-fill"></i> Ảnh bìa</th>
                <th class="text-nowrap"><i class="bi bi-upc"></i> Mã sách</th>
                <th><i class="bi bi-bookmark-fill"></i> Tên sách</th>
                <th><i class="bi bi-person-fill"></i> Tác giả</th>
                <th><i class="bi bi-tags-fill"></i> Thể loại</th>
                <th class="text-nowrap"><i class="bi bi-calendar-event-fill"></i> Năm XB</th>
                <th class="text-nowrap"><i class="bi bi-building"></i> Nhà xuất bản</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model)
            {
                <tr>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(book.ImageUrl))
                        {
                            <img src="@book.ImageUrl" alt="Bìa sách @book.Title" class="book-cover-thumb"
                                 onerror="this.onerror=null;this.outerHTML='<div class=&quot;book-cover-thumb book-cover-placeholder&quot;><i class=&quot;bi bi-book&quot;></i></div>';" />
                        }
                        else
                        {
                            <div class="book-cover-thumb book-cover-placeholder"><i class="bi bi-book"></i></div>
                        }
                    </td>
                    <td class="text-nowrap">@book.BookCode</td>
                    <td>@book.Title</td>
                    <td>@book.Author</td>
                    <td>@book.Genre</td>
                    <td>@book.PublicationYear</td>
                    <td>@book.Publisher</td>
                    <td class="text-nowrap">
                        <a asp-action="Details" asp-route-id="@book.BookCode" class="btn btn-sm btn-outline-light"><i class="bi bi-eye-fill"></i> Chi tiết</a>
                        <a asp-action="Edit" asp-route-id="@book.BookCode" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil-fill"></i> Sửa</a>
                        <a asp-action="Delete" asp-route-id="@book.BookCode" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash-fill"></i> Xóa</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>


@if (totalPages > 1)
{
    <nav aria-label="Phân trang danh sách sách">
        <ul class="pagination justify-content-center flex-wrap">
            <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-searchString="@ViewData["CurrentFilter"]"
                   asp-route-page="@(currentPage - 1)">&laquo; Trước</a>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" asp-action="Index"
                       asp-route-searchString="@ViewData["CurrentFilter"]"
                       asp-route-page="@i">@i</a>
                </li>
            }
            <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index"
                   asp-route-searchString="@ViewData["CurrentFilter"]"
                   asp-route-page="@(currentPage + 1)">Sau &raquo;</a>
            </li>
        </ul>
    </nav>
}

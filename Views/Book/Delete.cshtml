@model QuanLyThuVIen.Models.Book

@{
    ViewData["Title"] = "Xóa mã sách";
}

<h1><i class="bi bi-trash-fill"></i> Xóa mã sách</h1>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<h3><i class="bi bi-question-circle-fill"></i> Bạn có chắc muốn xóa mã sách này không?</h3>

@if (Model.BookCopies.Any())
{
    <div class="alert alert-danger">
        <i class="bi bi-exclamation-triangle-fill"></i> Không thể xóa vì mã sách này còn <strong>@Model.BookCopies.Count</strong> đầu sách (BookCopy) liên quan.
        Vui lòng xóa hết đầu sách trước.
    </div>
}

<div class="mb-3">
    @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
    {
        <img src="@Model.ImageUrl" alt="Bìa sách @Model.Title" class="book-cover-thumb"
             onerror="this.onerror=null;this.outerHTML='<div class=&quot;book-cover-thumb book-cover-placeholder&quot;><i class=&quot;bi bi-book&quot;></i></div>';" />
    }
</div>

<div>
    <dl class="row">
        <dt class="col-sm-2"><i class="bi bi-upc"></i> Mã sách</dt>
        <dd class="col-sm-10">@Model.BookCode</dd>

        <dt class="col-sm-2"><i class="bi bi-bookmark-fill"></i> Tên sách</dt>
        <dd class="col-sm-10">@Model.Title</dd>

        <dt class="col-sm-2"><i class="bi bi-person-fill"></i> Tác giả</dt>
        <dd class="col-sm-10">@Model.Author</dd>

        <dt class="col-sm-2"><i class="bi bi-tags-fill"></i> Thể loại</dt>
        <dd class="col-sm-10">@Model.Genre</dd>

        <dt class="col-sm-2"><i class="bi bi-calendar-event-fill"></i> Năm xuất bản</dt>
        <dd class="col-sm-10">@Model.PublicationYear</dd>

        <dt class="col-sm-2"><i class="bi bi-building"></i> Nhà xuất bản</dt>
        <dd class="col-sm-10">@Model.Publisher</dd>
    </dl>

    <form asp-action="Delete" asp-route-id="@Model.BookCode" method="post">
        @if (!Model.BookCopies.Any())
        {
            <button type="submit" class="btn btn-danger"><i class="bi bi-trash-fill"></i> Xóa</button>
        }
        <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-x-circle"></i> Hủy</a>
    </form>
</div>

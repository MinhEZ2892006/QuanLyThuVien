@model QuanLyThuVIen.Models.Book

@{
    ViewData["Title"] = "Chi tiết sách";
}

<h1><i class="bi bi-info-circle-fill"></i> Chi tiết sách</h1>

<div class="row g-4">
    <div class="col-auto">
        <div class="book-cover-frame">
            @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="Bìa sách @Model.Title" class="book-cover-lg"
                     onerror="this.onerror=null;this.outerHTML='<div class=&quot;book-cover-lg book-cover-placeholder&quot;><i class=&quot;bi bi-book&quot;></i></div>';" />
            }
            else
            {
                <div class="book-cover-lg book-cover-placeholder"><i class="bi bi-book"></i></div>
            }
        </div>
    </div>
    <div class="col">
        <dl class="row">
            <dt class="col-sm-3"><i class="bi bi-upc"></i> Mã sách</dt>
            <dd class="col-sm-9">@Model.BookCode</dd>

            <dt class="col-sm-3"><i class="bi bi-bookmark-fill"></i> Tên sách</dt>
            <dd class="col-sm-9">@Model.Title</dd>

            <dt class="col-sm-3"><i class="bi bi-person-fill"></i> Tác giả</dt>
            <dd class="col-sm-9">@Model.Author</dd>

            <dt class="col-sm-3"><i class="bi bi-tags-fill"></i> Thể loại</dt>
            <dd class="col-sm-9">@Model.Genre</dd>

            <dt class="col-sm-3"><i class="bi bi-calendar-event-fill"></i> Năm xuất bản</dt>
            <dd class="col-sm-9">@Model.PublicationYear</dd>

            <dt class="col-sm-3"><i class="bi bi-building"></i> Nhà xuất bản</dt>
            <dd class="col-sm-9">@Model.Publisher</dd>
        </dl>
    </div>
</div>

<div class="mt-4">
    <h3><i class="bi bi-collection-fill"></i> Danh sách đầu sách</h3>
    <p>
        <a asp-controller="BookCopy" asp-action="Create" asp-route-bookCode="@Model.BookCode" class="btn btn-sm btn-primary"><i class="bi bi-plus-circle-fill"></i> Thêm đầu sách</a>
    </p>
    @await Html.PartialAsync("_BookCopyList", Model.BookCopies)
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.BookCode" class="btn btn-primary"><i class="bi bi-pencil-fill"></i> Sửa</a>
    <a asp-action="Index" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại danh sách</a>
</div>

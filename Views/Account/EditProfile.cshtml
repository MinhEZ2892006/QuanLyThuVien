@model QuanLyThuVIen.Models.ViewModels.EditProfileViewModel
@{
    ViewData["Title"] = "Sửa thông tin cá nhân";
}

<h1><i class="bi bi-pencil-fill"></i> Sửa thông tin cá nhân</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="EditProfile" method="post">
            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="FullName" class="control-label"><i class="bi bi-person-fill"></i> Họ tên</label>
                <input asp-for="FullName" class="form-control" maxlength="100" />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="DateOfBirth" class="control-label"><i class="bi bi-calendar-heart-fill"></i> Ngày sinh</label>
                <input asp-for="DateOfBirth" class="form-control" type="date" />
                <span asp-validation-for="DateOfBirth" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="PhoneNumber" class="control-label"><i class="bi bi-telephone-fill"></i> Số điện thoại</label>
                <input asp-for="PhoneNumber" class="form-control" maxlength="20" />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="Address" class="control-label"><i class="bi bi-geo-alt-fill"></i> Địa chỉ</label>
                <input asp-for="Address" class="form-control" maxlength="200" />
                <span asp-validation-for="Address" class="text-danger"></span>
            </div>

            <div class="form-group mb-3">
                <label asp-for="AvatarUrl" class="control-label"><i class="bi bi-image-fill"></i> Ảnh đại diện (URL)</label>
                <input asp-for="AvatarUrl" class="form-control" maxlength="500" placeholder="https://..." />
                <span asp-validation-for="AvatarUrl" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle-fill"></i> Lưu</button>
            <a asp-action="Profile" class="btn btn-secondary"><i class="bi bi-x-circle"></i> Hủy</a>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

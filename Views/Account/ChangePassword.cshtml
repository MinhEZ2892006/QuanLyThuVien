@model QuanLyThuVIen.Models.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Đổi mật khẩu";
}

<h1><i class="bi bi-key-fill"></i> Đổi mật khẩu</h1>

<div class="auth-card">
    <div asp-validation-summary="All" class="text-danger mb-2"></div>

    <form asp-action="ChangePassword" method="post">
        <div class="form-group mb-3">
            <label asp-for="CurrentPassword" class="control-label"><i class="bi bi-lock-fill"></i> Mật khẩu hiện tại</label>
            <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="CurrentPassword" class="text-danger"></span>
        </div>

        <div class="form-group mb-3">
            <label asp-for="NewPassword" class="control-label"><i class="bi bi-key-fill"></i> Mật khẩu mới</label>
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
            <div class="form-text text-muted"><i class="bi bi-info-circle"></i> Tối thiểu 6 ký tự, phải có cả chữ và số.</div>
        </div>

        <div class="form-group mb-3">
            <label asp-for="ConfirmNewPassword" class="control-label"><i class="bi bi-key-fill"></i> Nhập lại mật khẩu mới</label>
            <input asp-for="ConfirmNewPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-check-circle-fill"></i> Đổi mật khẩu</button>
        <a asp-action="Profile" class="btn btn-secondary w-100 mt-2"><i class="bi bi-x-circle"></i> Hủy</a>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@model QuanLyThuVIen.Models.ApplicationUser
@using Microsoft.AspNetCore.Identity
@{
    ViewData["Title"] = "Trang cá nhân";
    var hasPassword = (bool)ViewBag.HasPassword;
    var externalLogins = (IList<UserLoginInfo>)ViewBag.ExternalLogins;
}

<h1><i class="bi bi-person-circle"></i> Trang cá nhân</h1>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success"><i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]</div>
}

<div class="row g-4">
    <div class="col-md-4 text-center">
        @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
        {
            <img src="@Model.AvatarUrl" alt="Ảnh đại diện" class="profile-avatar"
                 onerror="this.onerror=null;this.outerHTML='<div class=&quot;profile-avatar profile-avatar-placeholder mx-auto&quot;><i class=&quot;bi bi-person-fill&quot;></i></div>';" />
        }
        else
        {
            <div class="profile-avatar profile-avatar-placeholder mx-auto"><i class="bi bi-person-fill"></i></div>
        }
        <h3 class="mt-3 mb-0">@Model.FullName</h3>
        <p class="text-muted">@Model.Email</p>

        <div class="d-grid gap-2 mt-3">
            <a asp-action="EditProfile" class="btn btn-primary"><i class="bi bi-pencil-fill"></i> Sửa thông tin</a>
            @if (hasPassword)
            {
                <a asp-action="ChangePassword" class="btn btn-outline-secondary"><i class="bi bi-key-fill"></i> Đổi mật khẩu</a>
            }
        </div>
    </div>

    <div class="col-md-8">
        <dl class="row">
            <dt class="col-sm-4"><i class="bi bi-person-fill"></i> Họ tên</dt>
            <dd class="col-sm-8">@Model.FullName</dd>

            <dt class="col-sm-4"><i class="bi bi-envelope-fill"></i> Email</dt>
            <dd class="col-sm-8">@Model.Email</dd>

            <dt class="col-sm-4"><i class="bi bi-calendar-heart-fill"></i> Ngày sinh</dt>
            <dd class="col-sm-8">@(Model.DateOfBirth.HasValue ? Model.DateOfBirth.Value.ToString("dd/MM/yyyy") : "Chưa cập nhật")</dd>

            <dt class="col-sm-4"><i class="bi bi-telephone-fill"></i> Số điện thoại</dt>
            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Chưa cập nhật" : Model.PhoneNumber)</dd>

            <dt class="col-sm-4"><i class="bi bi-geo-alt-fill"></i> Địa chỉ</dt>
            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Address) ? "Chưa cập nhật" : Model.Address)</dd>

            <dt class="col-sm-4"><i class="bi bi-calendar-plus-fill"></i> Ngày tạo tài khoản</dt>
            <dd class="col-sm-8">@Model.CreatedDate.ToLocalTime().ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-4"><i class="bi bi-link-45deg"></i> Đăng nhập liên kết</dt>
            <dd class="col-sm-8">
                @if (externalLogins.Any())
                {
                    foreach (var login in externalLogins)
                    {
                        <span class="badge bg-primary me-1"><i class="bi bi-link"></i> @login.ProviderDisplayName</span>
                    }
                }
                else
                {
                    <span class="text-muted">Chưa liên kết Google/Facebook</span>
                }
            </dd>
        </dl>
    </div>
</div>

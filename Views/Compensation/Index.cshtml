@model List<QuanLyThuVIen.Models.CompensationCase>
@using QuanLyThuVIen.Models

@{
    var card = (LibraryCard)ViewBag.Card;
    ViewData["Title"] = "Bồi thường & mở lại thẻ";
}

<h1><i class="bi bi-cash-coin"></i> Bồi thường & mở lại thẻ</h1>
<p>
    <i class="bi bi-person-vcard-fill"></i> Thẻ: <strong>@card.CardNumber</strong> - @card.StudentName -
    @if (card.Status == LibraryCardStatus.Active)
    {
        <span class="badge bg-success"><i class="bi bi-unlock-fill"></i> Sử dụng được</span>
    }
    else
    {
        <span class="badge bg-danger"><i class="bi bi-lock-fill"></i> Không sử dụng</span>
    }
</p>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger"><i class="bi bi-exclamation-triangle-fill"></i> @TempData["Error"]</div>
}

<p>
    <a asp-controller="LibraryCard" asp-action="Details" asp-route-id="@card.CardNumber" class="btn btn-secondary"><i class="bi bi-arrow-left"></i> Quay lại thẻ</a>
</p>

@if (!Model.Any())
{
    <p class="text-muted"><i class="bi bi-check-circle-fill"></i> Thẻ này hiện không còn case bồi thường nào chưa xử lý.</p>
    @if (card.Status == LibraryCardStatus.Inactive)
    {
        <p class="text-warning"><i class="bi bi-exclamation-triangle-fill"></i> Thẻ vẫn đang bị khóa. Nếu đã hết case chưa xử lý mà thẻ chưa tự mở, kiểm tra lại bằng cách bồi thường case gần nhất hoặc dùng chức năng khóa/mở thủ công trên trang chi tiết thẻ.</p>
    }
}
else
{
    <table class="table table-sm">
        <thead>
            <tr>
                <th><i class="bi bi-calendar-event-fill"></i> Ngày phát sinh</th>
                <th><i class="bi bi-list-check"></i> Lý do</th>
                <th><i class="bi bi-upc"></i> Mã sách</th>
                <th><i class="bi bi-bookmark-fill"></i> Tên sách</th>
                <th><i class="bi bi-hash"></i> Số kiểm soát</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var c in Model)
            {
                <tr>
                    <td>@c.CreatedDate.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (c.Reason == CompensationReason.Lost)
                        {
                            <span class="badge bg-danger"><i class="bi bi-x-octagon-fill"></i> Mất</span>
                        }
                        else
                        {
                            <span class="badge bg-warning text-dark"><i class="bi bi-exclamation-triangle-fill"></i> Hỏng</span>
                        }
                    </td>
                    <td>@c.LoanDetail?.BookCopy?.BookCode</td>
                    <td>@c.LoanDetail?.BookCopy?.Book?.Title</td>
                    <td>@c.LoanDetail?.BookCopy?.ControlNumber</td>
                    <td>
                        <form asp-action="Resolve" asp-route-id="@c.CompensationCaseId" asp-route-cardNumber="@card.CardNumber" method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-success"><i class="bi bi-check-circle-fill"></i> Đã bồi thường</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <p class="text-muted"><i class="bi bi-info-circle-fill"></i> Khi case cuối cùng của thẻ được đánh dấu đã bồi thường, thẻ sẽ tự động mở lại (chuyển về "Sử dụng được").</p>
}
